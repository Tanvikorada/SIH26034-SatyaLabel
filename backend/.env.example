# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=satyalabel
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=satyalabel_sih26034_secret_change_this_in_production
JWT_EXPIRES_IN=24h

# Gemini Vision API (optional — Tesseract works without this)
# Get free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server
PORT=5000
NODE_ENV=development

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# OCR
# Confidence threshold below which Gemini Vision fallback is triggered (0-100)
OCR_CONFIDENCE_THRESHOLD=60
